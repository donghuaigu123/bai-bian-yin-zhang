<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 只依赖系统 Material 主题，不引入 AndroidX / AppCompat，方便纯命令行构建 -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:colorAccent">@color/seal_red</item>
        <item name="android:colorPrimary">@color/seal_red</item>
        <item name="android:colorPrimaryDark">@color/seal_red_dark</item>
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="android:textColorSecondary">@color/text_sub</item>
    </style>
</resources>
